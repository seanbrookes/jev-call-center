# Copy to .env and fill in values.

# --- Server ---
PORT=3101
# SQLite database path (relative to the project root)
DB_PATH=./jev-call-center.db

# --- Live simulation ---
# How often the live simulator ticks (each tick = one simulated "minute").
LIVE_INTERVAL_MS=2000
# Idle kill switch: stop the live simulation after this many ms with no page
# activity (the frontend sends a heartbeat while the user is interacting).
LIVE_IDLE_TIMEOUT_MS=3600000

# --- TypeSafe JEV (System One model) ---
# Endpoint: POST https://api.typesafe.ai/v1/systemone
TYPESAFE_API_KEY=your-key-here
TYPESAFE_BASE_URL=https://api.typesafe.ai/v1
TYPESAFE_MODEL=jev-latest